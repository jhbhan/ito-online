{
  "name": "ito-moderator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:online": "netlify dev",
    "check:server": "tsc --noEmit --target ES2022 --module nodenext --moduleResolution nodenext --types node --skipLibCheck netlify/functions/game.mts netlify/functions/cleanup.mts",
    "build": "tsc -b && npm run check:server && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/supabase-js": "^2.117.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.7.2",
    "vite": "^6.1.0"
  }
}
